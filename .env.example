# Copy this file to ".env" and fill in your own free keys.
# NEVER commit the real .env (it is gitignored).

# --- Database (Neon free Postgres) ---
# Neon dashboard -> your project -> "Connection string" (use the pooled one).
# Looks like: postgresql://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# --- AI extraction ---
# Google AI Studio (Gemini) free key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Model to use (free tier). Flash is fast + has huge context.
# Use the "-latest" alias, not a pinned version: Google retires exact versions
# (gemini-2.0-flash was retired and returned 404 for every page), which would
# silently kill the daily run. To see what your key can call:
#   curl -H "x-goog-api-key: $GEMINI_API_KEY" \
#        https://generativelanguage.googleapis.com/v1beta/models
GEMINI_MODEL=gemini-flash-latest

# Groq free key (fallback when Gemini rate-limits): https://console.groq.com/keys
# Groq also retires models (llama-3.3-70b-versatile is gone). Current list:
#   curl -H "Authorization: Bearer $GROQ_API_KEY" https://api.groq.com/openai/v1/models
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Behaviour tuning (optional) ---
# Polite delay between requests to the same site, in seconds.
FETCH_DELAY_SECONDS=2
# Max scholarship detail pages to process per run (keeps free tiers happy).
MAX_PAGES_PER_RUN=40
